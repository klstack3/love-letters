# Production environment variables for Vercel deployment
# This file is a template - set your actual values in the Vercel dashboard
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here
NODE_ENV=production

# Admin page (/admin)
ADMIN_PASSWORD=pick-something-long
# Fine-grained GitHub token with Contents: Read and write on this repo
GITHUB_TOKEN=github_pat_your_token_here
